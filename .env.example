# Backend
# Dùng MySQL production, ví dụ:
# DATABASE_URL=mysql+pymysql://username:password@host:3306/todolist
DATABASE_URL=sqlite:////data/todolist.db
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Frontend/backend URLs
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional email settings
# RESEND_API_KEY=
# MAIL_FROM=
# MAIL_FROM_NAME=TodoList App
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
